{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "72rem"
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"customDuotone": false,
			"link": true,
			"heading": true,
			"button": true,
			"caption": true,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#f7f6f3",
					"name": "Surface"
				},
				{
					"slug": "contrast",
					"color": "#121417",
					"name": "Contrast"
				},
				{
					"slug": "contrast-muted",
					"color": "#5b6168",
					"name": "Contrast muted"
				},
				{
					"slug": "accent",
					"color": "#1f5c4d",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#e7efea",
					"name": "Accent soft"
				}
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "subtle",
					"name": "Subtle",
					"shadow": "0 1px 2px rgba(18, 20, 23, 0.06), 0 2px 8px rgba(18, 20, 23, 0.04)"
				},
				{
					"slug": "raised",
					"name": "Raised",
					"shadow": "0 2px 4px rgba(18, 20, 23, 0.07), 0 8px 24px rgba(18, 20, 23, 0.07)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "4",
					"size": "clamp(2rem, 4vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "5",
					"size": "clamp(3rem, 6vw, 4.5rem)"
				},
				{
					"slug": "70",
					"name": "6",
					"size": "clamp(4rem, 8vw, 6.5rem)"
				},
				{
					"slug": "80",
					"name": "7",
					"size": "clamp(5rem, 10vw, 9rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"letterSpacing": true,
			"fontStyle": true,
			"fontWeight": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Instrument Serif\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-latin-v5.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.875rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "1rem",
					"fluid": {
						"min": "0.9375rem",
						"max": "1rem"
					}
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Extra extra large",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"button": {
				"border": {
					"radius": "0.25rem"
				},
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"lineHeight": "1.5"
				}
			},
			"cite": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"fontStyle": "normal"
				}
			},
			"select": {
				"border": {
					"color": "var:preset|color|contrast-muted",
					"radius": "0.25rem",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "0.625rem",
						"bottom": "0.625rem",
						"left": "0.75rem",
						"right": "0.75rem"
					}
				}
			},
			"textInput": {
				"border": {
					"color": "var:preset|color|contrast-muted",
					"radius": "0.25rem",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "0.625rem",
						"bottom": "0.625rem",
						"left": "0.75rem",
						"right": "0.75rem"
					}
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"color": "var:preset|color|accent-soft",
					"radius": "0.25rem",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small",
					"lineHeight": "1.6"
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.45"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.25"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|accent-soft"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							},
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/post-author-name": {
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|accent"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"letterSpacing": "-0.015em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var:preset|color|contrast-muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page, wide",
			"postTypes": [
				"page"
			]
		}
	]
}
